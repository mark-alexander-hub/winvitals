<UserControl x:Class="WinVitals.App.Views.ChooseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,0,32,28">
        <StackPanel>
            <ItemsControl x:Name="PlaybookList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChoiceCard}" Click="OnPlaybookChosen"
                                Tag="{Binding Id}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                        Background="{DynamicResource AccentSoftBrush}" Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}"
                                               FontSize="18" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="16" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}"
                                               Margin="0,3,12,0" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding Duration}"
                                           Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
