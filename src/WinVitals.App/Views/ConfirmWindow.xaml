<Window x:Class="WinVitals.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm changes" Height="620" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="Headline" Style="{StaticResource H1}" FontSize="21"
                       Text="Review what will change" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0"
                       Text="Nothing has been changed yet. This is exactly what will happen if you continue." />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="Host" />
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0"
                Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}">
            <StackPanel>
                <TextBlock Text="Before anything runs" Style="{StaticResource Label}"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                           Text="WinVitals will create a system restore point and then check that it really was created. If Windows silently refuses — which it does if another restore point was made in the last 24 hours — you will be told before any change is made, not afterwards." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource Secondary}" Content="Cancel" Margin="0,0,8,0" Click="OnCancel"
                    IsCancel="True" />
            <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Content="Apply" Click="OnApply"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
