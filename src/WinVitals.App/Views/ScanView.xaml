<UserControl x:Class="WinVitals.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,0,28,28">
        <Border Style="{StaticResource Card}" VerticalAlignment="Center" Padding="28,26">
            <StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource H2}" Text="Starting..." />

                <ProgressBar x:Name="Progress" Style="{StaticResource Bar}" Margin="0,18,0,0"
                             Minimum="0" Maximum="100" Value="0" />

                <TextBlock x:Name="DetailText" Style="{StaticResource Muted}" Margin="0,12,0,0"
                           Text="Reading system information. Nothing is being changed." />

                <TextBlock x:Name="DoneList" Style="{StaticResource Muted}" Margin="0,14,0,0"
                           FontSize="12" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
