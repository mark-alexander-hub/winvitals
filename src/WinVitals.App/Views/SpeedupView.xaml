<UserControl x:Class="WinVitals.App.Views.SpeedupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WinVitals.App.Views">
    <ScrollViewer Padding="32,0,32,28">
        <StackPanel>

            <!-- Boot time: the number that makes this page honest -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,28,0" MinWidth="150">
                        <TextBlock Text="LAST BOOT" Style="{StaticResource Label}" />
                        <TextBlock x:Name="BootBig" FontSize="40" FontWeight="Bold"
                                   Foreground="{DynamicResource InkBrush}" Text="…" Margin="0,2,0,0" />
                        <TextBlock x:Name="BootWhen" Style="{StaticResource Muted}" Text="" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="BootHeadline" Style="{StaticResource H2}" FontSize="16"
                                   Text="Measuring how long this PC takes to start…" />
                        <TextBlock x:Name="BootDetail" Style="{StaticResource Muted}" Margin="0,4,0,0" Text="" />
                        <TextBlock x:Name="Comparison" Style="{StaticResource Body}" Margin="0,10,0,0"
                                   Visibility="Collapsed" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="ResetCompare" Style="{StaticResource Ghost}" Content="Reset the comparison"
                                    Visibility="Collapsed" Margin="-8,0,0,0" Click="OnResetComparison" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Startup programs -->
            <views:StartupView x:Name="Startup" />

            <!-- Performance tools -->
            <TextBlock Text="MORE WAYS TO SPEED UP AN OLDER PC" Style="{StaticResource Label}" Margin="2,18,0,10" />
            <StackPanel x:Name="Tools" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
