<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>WinVitals</AssemblyName>
    <RootNamespace>WinVitals.App</RootNamespace>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- System.Management is reflection-heavy over WMI; trimming breaks it. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- InvariantGlobalization must stay off. WPF is not supported under it: font
         fallback initialises MS.Internal.FontCache.MajorLanguages, which needs real
         culture data, and any specific-culture lookup fails with "Cannot find
         non-neutral culture related to 'en-us'". It saves binary size and breaks the
         first dialog that renders a multi-family font. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Release requires administrator (app.manifest). Debug is asInvoker so the
         interface can be driven by automated tests without a UAC prompt per run. -->
    <ApplicationManifest Condition="'$(Configuration)' == 'Debug'">app.debug.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' != 'Debug'">app.manifest</ApplicationManifest>
    <Version>0.3.0</Version>
    <Product>WinVitals</Product>
    <Description>Diagnose and repair a Windows PC, in plain English.</Description>
    <Company>WinVitals contributors</Company>
    <Copyright>Copyright (c) 2026 WinVitals contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WinVitals.Core/WinVitals.Core.csproj" />
  </ItemGroup>

</Project>
